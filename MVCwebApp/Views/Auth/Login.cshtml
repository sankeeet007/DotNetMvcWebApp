@using MVCwebApp.Dto
@model UserDto

<div class="text-center text-danger fw-bold">@ViewBag.SuccessMessage</div>
<div class="text-center text-danger fw-bold">@ViewBag.ErrorMessage</div>
<form class="p-4 border rounded shadow-sm bg-white" style="max-width: 400px; margin: 0 auto;" asp-action="LoginUser">
    <h2 class="text-center mb-4">Login</h2>


    <div class="mb-3">
        <label for="email" class="form-label">Email address</label>
        <input type="email" class="form-control" id="email" name="email" asp-for="Email" required>
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input type="password" class="form-control" id="password" name="password" asp-for="Password" required>
    </div>

    <button type="submit" class="btn btn-primary w-100 mt-2">Sign In</button>
</form>
<div class="text-center">
    New User?<a asp-controller="Auth" asp-action="Register">Register Here</a>
</div>
